# Supabase project URL — same project ref as the Studio URL
NEXT_PUBLIC_SUPABASE_URL=https://fhsrpkorvuwvwacapbig.supabase.co

# Server-only key. Service role bypasses RLS — never expose to the browser.
# Stored as a normal (non-NEXT_PUBLIC_) env var so it stays server-side only.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Table name in the public schema. Columns expected:
#   id (uuid), wallet_address (text), connected_at (timestamptz),
#   balance (numeric), harvest_balance (numeric)
SUPABASE_TABLE=wallets
